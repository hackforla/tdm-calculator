# SQL_SERVER_INSTANCE=
# SQL_SERVER_PORT=1434
# SQL_DATABASE_NAME=tdmdev
# SQL_USER_NAME=sa
# SQL_PASSWORD=Dogfood1!
# SQL_ENCRYPT=false
# SQL_TRUST_SERVER_CERTIFICATE=true

## Local Development Database - Windows Native
